  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single solve action at the foot of the input card.",
      "html": "<button class=\"ds-btn-primary\">Giải bài</button>",
      "css": ".ds-btn-primary{width:100%;height:42px;border:0;border-radius:8px;cursor:pointer;background:#2563eb;color:#fff;font:600 15px/1.5 Inter,system-ui,sans-serif;box-shadow:0 1px 2px rgba(29,78,216,.3);transition:background .15s,transform .1s}.ds-btn-primary:hover{background:#1d4ed8}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid #2563eb;outline-offset:2px}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "Chart tools: zoom out, zoom in, fit, print.",
      "html": "<button class=\"ds-icon-btn\" aria-label=\"Phóng to\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-icon-btn{display:grid;place-items:center;width:34px;height:34px;border:1px solid #e3e7ed;border-radius:8px;background:#fff;cursor:pointer;color:#5b6577;transition:color .15s,background .15s}.ds-icon-btn:hover{color:#0f172a;background:#f3f5f8}.ds-icon-btn:focus-visible{outline:2px solid #2563eb;outline-offset:2px}.ds-icon-btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round}"
    },
    {
      "name": "Field with Unit",
      "kind": "input",
      "refersTo": "input",
      "description": "Numeric input with inline unit select.",
      "html": "<label class=\"ds-field\"><span>Khoảng cách d</span><span class=\"ds-input\"><input value=\"0.18\"><select><option>λ</option><option>m</option></select></span></label>",
      "css": ".ds-field{display:grid;gap:6px;font:15px/1.5 Inter,system-ui,sans-serif;font-feature-settings:'tnum'}.ds-field>span:first-child{font-size:13px;font-weight:500;color:#3d4757}.ds-input{display:flex;align-items:center;height:40px;border:1px solid #c9d0da;border-radius:8px;background:#fff;transition:border-color .15s,box-shadow .15s}.ds-input:focus-within{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.15)}.ds-input input{flex:1;min-width:0;height:100%;border:0;background:none;padding:0 12px;outline:none;font:inherit}.ds-input select{height:100%;border:0;border-left:1px solid #e3e7ed;background:#f3f5f8;padding:0 8px;border-radius:0 7px 7px 0;font:inherit}"
    },
    {
      "name": "Underline Tabs",
      "kind": "nav",
      "refersTo": "tab-underline",
      "description": "Problem-type tabs in the top bar.",
      "html": "<nav class=\"ds-tabs\"><button aria-selected=\"true\">Đường truyền</button><button>Biến đổi λ/4</button><button>Dây chêm đơn</button></nav>",
      "css": ".ds-tabs{display:flex;gap:4px;height:60px;border-bottom:1px solid #e3e7ed;background:#fff;font:500 15px Inter,system-ui,sans-serif}.ds-tabs button{position:relative;border:0;background:none;padding:0 12px;cursor:pointer;color:#5b6577;font:inherit;transition:color .15s}.ds-tabs button:hover,.ds-tabs button[aria-selected=true]{color:#0f172a}.ds-tabs button[aria-selected=true]::after{content:'';position:absolute;left:12px;right:12px;bottom:-1px;height:2px;background:#2563eb;border-radius:2px}.ds-tabs button:focus-visible{outline:2px solid #2563eb;outline-offset:-2px}"
    },
    {
      "name": "Solution Segmented",
      "kind": "chip",
      "refersTo": "segmented-option",
      "description": "Nghiệm 1 / Nghiệm 2 switch; selected text takes the solution colour.",
      "html": "<div class=\"ds-seg\"><button aria-selected=\"true\" data-i=\"0\">Nghiệm 1</button><button data-i=\"1\">Nghiệm 2</button></div>",
      "css": ".ds-seg{display:inline-flex;padding:3px;gap:2px;background:#f3f5f8;border-radius:9px;font:500 14px Inter,system-ui,sans-serif}.ds-seg button{border:0;background:none;padding:5px 14px;border-radius:7px;cursor:pointer;color:#5b6577;font:inherit}.ds-seg button:hover{color:#0f172a}.ds-seg button[aria-selected=true]{background:#fff;box-shadow:0 1px 2px rgba(15,23,42,.12)}.ds-seg button[data-i='0'][aria-selected=true]{color:#2563eb}.ds-seg button[data-i='1'][aria-selected=true]{color:#e3550c}.ds-seg button:focus-visible{outline:2px solid #2563eb;outline-offset:2px}"
    },
    {
      "name": "Answer Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Big tabular answer figures with solution tag, top of the output column.",
      "html": "<section class=\"ds-card\"><div class=\"ds-head\"><h2>Đáp số</h2><span class=\"ds-tag\">Nghiệm 1</span></div><dl class=\"ds-ans\"><div><dt>d</dt><dd>0.0369λ</dd></div><div><dt>l</dt><dd>0.1250λ</dd></div></dl></section>",
      "css": ".ds-card{background:#fff;border:1px solid #e3e7ed;border-radius:10px;padding:20px;box-shadow:0 1px 2px rgba(15,23,42,.05),0 4px 16px -8px rgba(15,23,42,.08);font:15px/1.5 Inter,system-ui,sans-serif;font-feature-settings:'cv11','tnum';color:#1e293b}.ds-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.ds-head h2{margin:0;font-size:15px;font-weight:600;color:#0f172a}.ds-tag{font-size:12.5px;font-weight:500;color:#2563eb;background:#e9f0fd;padding:3px 10px;border-radius:99px}.ds-ans{margin:0;display:grid;grid-template-columns:1fr 1fr;gap:16px 12px}.ds-ans dt{font-size:13px;color:#5b6577}.ds-ans dd{margin:2px 0 0;font-size:24px;font-weight:600;letter-spacing:-.02em;line-height:1.2;color:#0f172a}"
    },
    {
      "name": "Step Row",
      "kind": "custom",
      "refersTo": "step-item",
      "description": "'Bước n — …' row with point badges; pinned state lights the chart.",
